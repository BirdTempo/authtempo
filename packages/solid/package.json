  },
  "dependencies": {
    "@authtempo/client": "workspace:*",
    "@authtempo/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "happy-dom": "20.14.6",
    "solid-js": "1.9.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
