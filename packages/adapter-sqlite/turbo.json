{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // tsconfig.pool.json reads proof/worker/index.ts and test/pool, which
    // import @authtempo/adapter-sqlite from this package's own dist. A build
    // empties that dist first (scripts/clean-dist.mjs). So the build of the
    // package comes first: a run that held both tasks failed with TS2307
    // (2026-10-21, ruling 17 of plan 12g).
    "typecheck": { "dependsOn": ["^build", "build"] }
  }
}
