{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The bundle proof of the libSQL entry on Workers (plan 12g Task 4).
  "name": "authtempo-adapter-sqlite-proof",
  "main": "index.ts",
  "compatibility_date": "2026-09-30",
  // Workers turn nodejs_compat on by default from compatibility date
  // 2026-08-04 (Cloudflare changelog, read 2026-10-11). These two flags turn
  // it off, so a Node.js module in the bundle fails proof/bundle.mjs.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  // This Worker is only bundled (`wrangler deploy --dry-run`), never deployed.
  // If a deploy runs by mistake, it gets no workers.dev URL and no preview URL.
  "workers_dev": false,
  "preview_urls": false
}
