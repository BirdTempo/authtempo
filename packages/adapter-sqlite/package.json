{
  "name": "@authtempo/adapter-sqlite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.ts",
      "default": "./dist/better-sqlite3.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./libsql": {
      "types": "./dist/libsql.d.ts",
      "default": "./dist/libsql.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && node scripts/copy-migrations.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/copy-migrations.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.pool.json",
    "test": "vitest run && bun --bun vitest run -c vitest.bun.config.ts && vitest run -c vitest.pool.config.ts && node proof/bundle.mjs"
  },
  "dependencies": {
    "@authtempo/adapter-d1": "workspace:*",
    "@authtempo/core": "workspace:*"
  },
  "peerDependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^13.0.3"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@libsql/client": "0.18.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.1",
    "better-sqlite3": "13.0.3",
    "bun": "1.4.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
