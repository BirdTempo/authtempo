{
  "name": "@authtempo/fastify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@authtempo/core": "workspace:*"
  },
  "peerDependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fastify": "5.12.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
