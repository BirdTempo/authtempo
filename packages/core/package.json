{
  "name": "@authtempo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./conformance": {
      "types": "./dist/storage/conformance.d.ts",
      "default": "./dist/storage/conformance.js"
    },
    "./limiter-conformance": {
      "types": "./dist/limiter/conformance.d.ts",
      "default": "./dist/limiter/conformance.js"
    },
    "./sql": {
      "types": "./dist/storage/sql.d.ts",
      "default": "./dist/storage/sql.js"
    },
    "./ddl": {
      "types": "./dist/storage/ddl.d.ts",
      "default": "./dist/storage/ddl.js"
    },
    "./shape-conformance": {
      "types": "./dist/storage/shape-conformance.d.ts",
      "default": "./dist/storage/shape-conformance.js"
    },
    "./operator-secret": {
      "types": "./dist/operator-secret.d.ts",
      "default": "./dist/operator-secret.js"
    },
    "./secrets": {
      "types": "./dist/secrets-entry.d.ts",
      "default": "./dist/secrets-entry.js"
    },
    "./testing": {
      "types": "./dist/testing/soft-authenticator.d.ts",
      "default": "./dist/testing/soft-authenticator.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./observe": {
      "types": "./dist/observe/index.d.ts",
      "default": "./dist/observe/index.js"
    },
    "./social-entries": {
      "types": "./dist/social/entries/index.d.ts",
      "default": "./dist/social/entries/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "authtempo": {
    "schemaVersion": 15
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && node ../../scripts/write-version.mjs VERSION && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/write-version.mjs VERSION && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && vitest run --config vitest.answers.config.ts && vitest run --config vitest.events.config.ts",
    "measure": "vitest run --config vitest.measure.config.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "jose": "6.2.12",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "5.0.3",
    "xml-crypto": "6.3.3"
  }
}
