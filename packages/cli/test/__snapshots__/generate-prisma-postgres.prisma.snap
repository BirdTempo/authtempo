// authtempo schema version 15, dialect postgres, authtempo CLI <version>. authtempo owns these tables. Create and change them with `authtempo migrate`. Write rows through the engine only.
// This file is for reads. A write through the ORM skips the engine's guards: the claim rule, the conditional consume, and the undo of a user create.
// Add these two keys to prisma.config.ts, so Prisma Migrate leaves the ta_ tables alone:
//   experimental: { externalTables: true },
//   tables: { external: ["public.ta_user", "public.ta_identity", "public.ta_session", "public.ta_verification", "public.ta_passkey", "public.ta_organization", "public.ta_member", "public.ta_invitation", "public.ta_password", "public.ta_api_token", "public.ta_totp", "public.ta_trusted_device", "public.ta_jwk", "public.ta_oauth_client", "public.ta_oauth_consent", "public.ta_oauth_token", "public.ta_oauth_device", "public.ta_oauth_subject", "public.ta_oauth_session_client", "public.ta_oauth_logout", "public.ta_second_factor", "public.ta_operator_audit", "public.ta_organization_role", "public.ta_team", "public.ta_team_member", "public.ta_organization_token", "public.ta_moved_token", "public.ta_sso_connection", "public.ta_sso_domain", "public.ta_scim_token", "public.ta_scim_user", "public.ta_scim_group", "public.ta_scim_group_member"] },
// Externally managed tables are a Preview feature in Prisma 7.10 (read 2026-10-22).
// The list names the schema public. Write the schema of the app in its place.
// Keep ta_meta, ta_limit, and ta_migrations out of each Prisma migration too.

model TaUser {
  id String @id @map("id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  email String? @map("email")
  emailVerified Boolean @map("email_verified")
  name String? @map("name")
  image String? @map("image")
  bannedAt DateTime? @map("banned_at") @db.Timestamptz(6)
  banReason String? @map("ban_reason")
  banUntil DateTime? @map("ban_until") @db.Timestamptz(6)
  username String? @map("username")
  displayUsername String? @map("display_username")
  phone String? @map("phone")
  isAnonymous Boolean @map("is_anonymous")

  @@unique([email], map: "ux_ta_user__email")
  @@unique([username], map: "ux_ta_user__username")
  @@unique([phone], map: "ux_ta_user__phone")
  @@index([isAnonymous, createdAt], map: "ix_ta_user__is_anonymous__created_at")
  @@map("ta_user")
}

model TaIdentity {
  id String @id @map("id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  userId String @map("user_id")
  provider String @map("provider")
  subject String @map("subject")
  linkedAt DateTime @map("linked_at") @db.Timestamptz(6)

  @@unique([provider, subject], map: "ux_ta_identity__provider__subject")
  @@index([userId], map: "ix_ta_identity__user_id")
  @@map("ta_identity")
}

model TaSession {
