  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)
  ip String? @map("ip")
  userAgent String? @map("user_agent")
  activeOrganizationId String? @map("active_organization_id")
  freshAt DateTime? @map("fresh_at") @db.Timestamptz(6)
  actorId String? @map("actor_id")
  activeTeamId String? @map("active_team_id")

  @@unique([tokenHash], map: "ux_ta_session__token_hash")
  @@index([userId], map: "ix_ta_session__user_id")
  @@index([activeOrganizationId], map: "ix_ta_session__active_organization_id")
  @@map("ta_session")
}

