  version Int @map("version")

  @@unique([organizationId, userId], map: "ux_ta_scim_user__organization_id__user_id")
  @@unique([organizationId, userNameKey], map: "ux_ta_scim_user__organization_id__user_name_key")
  @@index([organizationId, externalId], map: "ix_ta_scim_user__organization_id__external_id")
  @@map("ta_scim_user")
}

model TaScimGroup {
  id String @id @map("id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  organizationId String @map("organization_id")
  displayName String @map("display_name")
  displayNameKey String @map("display_name_key")
  externalId String? @map("external_id")
  teamId String? @map("team_id")
  version Int @map("version")

  @@unique([organizationId, displayNameKey], map: "ux_ta_scim_group__organization_id__display_name_key")
  @@index([organizationId, externalId], map: "ix_ta_scim_group__organization_id__external_id")
  @@map("ta_scim_group")
}

model TaScimGroupMember {
  id String @id @map("id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  groupId String @map("group_id")
  scimUserId String @map("scim_user_id")

  @@unique([groupId, scimUserId], map: "ux_ta_scim_group_member__group_id__scim_user_id")
  @@index([scimUserId], map: "ix_ta_scim_group_member__scim_user_id")
  @@map("ta_scim_group_member")
}
