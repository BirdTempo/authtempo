  lastUsedAt BigInt? @map("last_used_at")

  @@unique([tokenHash], map: "ux_ta_scim_token__token_hash")
  @@index([organizationId], map: "ix_ta_scim_token__organization_id")
  @@map("ta_scim_token")
}

model TaScimUser {
