  tokenHash String @map("token_hash") @db.VarChar(64)
  /// epoch milliseconds
  expiresAt BigInt @map("expires_at")
  /// epoch milliseconds
  lastSeenAt BigInt @map("last_seen_at")
  ip String? @map("ip") @db.Text
  userAgent String? @map("user_agent") @db.Text
  activeOrganizationId String? @map("active_organization_id") @db.VarChar(64)
  /// epoch milliseconds
  freshAt BigInt? @map("fresh_at")
  actorId String? @map("actor_id") @db.Text
  activeTeamId String? @map("active_team_id") @db.Text

  @@unique([tokenHash], map: "ux_ta_session__token_hash")
  @@index([userId], map: "ix_ta_session__user_id")
  @@index([activeOrganizationId], map: "ix_ta_session__active_organization_id")
  @@map("ta_session")
}

