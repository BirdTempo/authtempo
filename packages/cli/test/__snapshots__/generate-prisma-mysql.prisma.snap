// authtempo schema version 14, dialect mysql, authtempo CLI 0.0.0. authtempo owns these tables. Create and change them with `authtempo migrate`. Write rows through the engine only.
// This file is for reads. A write through the ORM skips the engine's guards: the claim rule, the conditional consume, and the undo of a user create.
// Add these two keys to prisma.config.ts, so Prisma Migrate leaves the ta_ tables alone:
//   experimental: { externalTables: true },
//   tables: { external: ["ta_user", "ta_identity", "ta_session", "ta_verification", "ta_passkey", "ta_organization", "ta_member", "ta_invitation", "ta_password", "ta_api_token", "ta_totp", "ta_trusted_device", "ta_jwk", "ta_oauth_client", "ta_oauth_consent", "ta_oauth_token", "ta_oauth_device", "ta_oauth_subject", "ta_oauth_session_client", "ta_oauth_logout", "ta_second_factor", "ta_operator_audit", "ta_organization_role", "ta_team", "ta_team_member", "ta_organization_token", "ta_moved_token", "ta_sso_connection", "ta_sso_domain", "ta_scim_token", "ta_scim_user", "ta_scim_group", "ta_scim_group_member"] },
// Externally managed tables are a Preview feature in Prisma 7.10 (read 2026-10-22).
// Keep ta_meta, ta_limit, and ta_migrations out of each Prisma migration too.

model TaUser {
  id String @id @map("id") @db.VarChar(64)
  /// epoch milliseconds
  createdAt BigInt @map("created_at")
  /// epoch milliseconds
  updatedAt BigInt @map("updated_at")
  email String @map("email") @db.VarChar(254)
  emailVerified Boolean @map("email_verified")
  name String? @map("name") @db.Text
  image String? @map("image") @db.Text
  /// epoch milliseconds
  bannedAt BigInt? @map("banned_at")
  banReason String? @map("ban_reason") @db.Text
  /// epoch milliseconds
  banUntil BigInt? @map("ban_until")

  @@unique([email], map: "ux_ta_user__email")
  @@map("ta_user")
}

model TaIdentity {
  id String @id @map("id") @db.VarChar(64)
  /// epoch milliseconds
  createdAt BigInt @map("created_at")
  /// epoch milliseconds
  updatedAt BigInt @map("updated_at")
  userId String @map("user_id") @db.VarChar(64)
  provider String @map("provider") @db.VarChar(64)
  subject String @map("subject") @db.VarChar(255)
  /// epoch milliseconds
  linkedAt BigInt @map("linked_at")

  @@unique([provider, subject], map: "ux_ta_identity__provider__subject")
  @@index([userId], map: "ix_ta_identity__user_id")
  @@map("ta_identity")
}

model TaSession {
  id String @id @map("id") @db.VarChar(64)
  /// epoch milliseconds
