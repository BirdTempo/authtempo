// authtempo schema version 13, dialect mysql, authtempo CLI 0.0.0. authtempo owns these tables. Create and change them with `authtempo migrate`. Write rows through the engine only.
// This file is for reads. A write through the ORM skips the engine's guards: the claim rule, the conditional consume, and the undo of a user create.
// Keep this file out of the schema glob of drizzle.config.ts, so drizzle-kit generate writes no migration for it.
// Set tablesFilter in drizzle.config.ts to the table patterns of the app, so drizzle-kit push and pull leave the ta_ tables alone.
// The Drizzle Kit page documents no negation form for tablesFilter (orm.drizzle.team/docs/drizzle-config-file, read 2026-10-22).

import { bigint, boolean, customType, index, int, json, mysqlTable, text, uniqueIndex, varchar } from "drizzle-orm/mysql-core";

/** A BIGINT of epoch milliseconds, read as a Date. */
const epochMs = customType<{ data: Date; driverData: number | string }>({
  dataType: () => "bigint",
  fromDriver: (value) => new Date(Number(value)),
  toDriver: (value) => value.getTime(),
});

export const taUser = mysqlTable(
  "ta_user",
  {
    id: varchar("id", { length: 64 }).primaryKey(),
    createdAt: epochMs("created_at").notNull(),
    updatedAt: epochMs("updated_at").notNull(),
    email: varchar("email", { length: 254 }).notNull(),
    emailVerified: boolean("email_verified").notNull(),
    name: text("name"),
    image: text("image"),
    bannedAt: epochMs("banned_at"),
    banReason: text("ban_reason"),
    banUntil: epochMs("ban_until"),
  },
  (t) => [
    uniqueIndex("ux_ta_user__email").on(t.email),
  ],
);

export const taIdentity = mysqlTable(
  "ta_identity",
  {
    id: varchar("id", { length: 64 }).primaryKey(),
    createdAt: epochMs("created_at").notNull(),
    updatedAt: epochMs("updated_at").notNull(),
    userId: varchar("user_id", { length: 64 }).notNull(),
    provider: varchar("provider", { length: 64 }).notNull(),
    subject: varchar("subject", { length: 255 }).notNull(),
    linkedAt: epochMs("linked_at").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_identity__provider__subject").on(t.provider, t.subject),
    index("ix_ta_identity__user_id").on(t.userId),
  ],
);

export const taSession = mysqlTable(
  "ta_session",
  {
    id: varchar("id", { length: 64 }).primaryKey(),
    createdAt: epochMs("created_at").notNull(),
    updatedAt: epochMs("updated_at").notNull(),
    userId: varchar("user_id", { length: 64 }).notNull(),
    tokenHash: varchar("token_hash", { length: 64 }).notNull(), // hash
    expiresAt: epochMs("expires_at").notNull(),
    lastSeenAt: epochMs("last_seen_at").notNull(),
    ip: text("ip"),
    userAgent: text("user_agent"),
    activeOrganizationId: varchar("active_organization_id", { length: 64 }),
    freshAt: epochMs("fresh_at"),
    actorId: text("actor_id"),
    activeTeamId: text("active_team_id"),
  },
  (t) => [
    uniqueIndex("ux_ta_session__token_hash").on(t.tokenHash),
    index("ix_ta_session__user_id").on(t.userId),
    index("ix_ta_session__active_organization_id").on(t.activeOrganizationId),
  ],
);

export const taVerification = mysqlTable(
  "ta_verification",
  {
    id: varchar("id", { length: 64 }).primaryKey(),
    createdAt: epochMs("created_at").notNull(),
    updatedAt: epochMs("updated_at").notNull(),
    purpose: varchar("purpose", { length: 32 }).notNull(),
    identifier: varchar("identifier", { length: 2048 }).notNull(),
    valueHash: varchar("value_hash", { length: 64 }).notNull(), // hash
    expiresAt: epochMs("expires_at").notNull(),
    consumedAt: epochMs("consumed_at"),
    data: json("data"),
    secretVersion: int("secret_version").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_verification__value_hash").on(t.valueHash),
    index("ix_ta_verification__purpose__identifier").on(t.purpose, t.identifier),
  ],
);

