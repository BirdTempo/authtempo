// authtempo schema version 16, dialect postgres, authtempo CLI <version>. authtempo owns these tables. Create and change them with `authtempo migrate`. Write rows through the engine only.
// This file is for reads. A write through the ORM skips the engine's guards: the claim rule, the conditional consume, and the undo of a user create.
// Keep this file out of the schema glob of drizzle.config.ts, so drizzle-kit generate writes no migration for it.
// Set tablesFilter in drizzle.config.ts to the table patterns of the app, so drizzle-kit push and pull leave the ta_ tables alone.
// The Drizzle Kit page documents no negation form for tablesFilter (orm.drizzle.team/docs/drizzle-config-file, read 2026-10-22).

import { bigint, boolean, index, integer, jsonb, pgTable, text, timestamp, uniqueIndex } from "drizzle-orm/pg-core";

export const taUser = pgTable(
  "ta_user",
  {
    id: text("id").primaryKey(),
    createdAt: timestamp("created_at", { withTimezone: true, mode: "date" }).notNull(),
    updatedAt: timestamp("updated_at", { withTimezone: true, mode: "date" }).notNull(),
    email: text("email"),
    emailVerified: boolean("email_verified").notNull(),
    name: text("name"),
    image: text("image"),
    bannedAt: timestamp("banned_at", { withTimezone: true, mode: "date" }),
    banReason: text("ban_reason"),
    banUntil: timestamp("ban_until", { withTimezone: true, mode: "date" }),
    username: text("username"),
    displayUsername: text("display_username"),
    phone: text("phone"),
    isAnonymous: boolean("is_anonymous").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_user__email").on(t.email),
    uniqueIndex("ux_ta_user__username").on(t.username),
    uniqueIndex("ux_ta_user__phone").on(t.phone),
    index("ix_ta_user__is_anonymous__created_at").on(t.isAnonymous, t.createdAt),
  ],
);

export const taIdentity = pgTable(
  "ta_identity",
  {
    id: text("id").primaryKey(),
    createdAt: timestamp("created_at", { withTimezone: true, mode: "date" }).notNull(),
    updatedAt: timestamp("updated_at", { withTimezone: true, mode: "date" }).notNull(),
    userId: text("user_id").notNull(),
    provider: text("provider").notNull(),
    subject: text("subject").notNull(),
    linkedAt: timestamp("linked_at", { withTimezone: true, mode: "date" }).notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_identity__provider__subject").on(t.provider, t.subject),
    index("ix_ta_identity__user_id").on(t.userId),
  ],
);

export const taSession = pgTable(
  "ta_session",
  {
    id: text("id").primaryKey(),
    createdAt: timestamp("created_at", { withTimezone: true, mode: "date" }).notNull(),
    updatedAt: timestamp("updated_at", { withTimezone: true, mode: "date" }).notNull(),
    userId: text("user_id").notNull(),
    tokenHash: text("token_hash").notNull(), // hash
    expiresAt: timestamp("expires_at", { withTimezone: true, mode: "date" }).notNull(),
    lastSeenAt: timestamp("last_seen_at", { withTimezone: true, mode: "date" }).notNull(),
    ip: text("ip"),
    userAgent: text("user_agent"),
    activeOrganizationId: text("active_organization_id"),
    freshAt: timestamp("fresh_at", { withTimezone: true, mode: "date" }),
    actorId: text("actor_id"),
    activeTeamId: text("active_team_id"),
    proved: boolean("proved").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_session__token_hash").on(t.tokenHash),
    index("ix_ta_session__user_id").on(t.userId),
    index("ix_ta_session__active_organization_id").on(t.activeOrganizationId),
  ],
);

