// authtempo schema version 14, dialect sqlite, authtempo CLI 0.0.0. authtempo owns these tables. Create and change them with `authtempo migrate`. Write rows through the engine only.
// This file is for reads. A write through the ORM skips the engine's guards: the claim rule, the conditional consume, and the undo of a user create.
// Keep this file out of the schema glob of drizzle.config.ts, so drizzle-kit generate writes no migration for it.
// Set tablesFilter in drizzle.config.ts to the table patterns of the app, so drizzle-kit push and pull leave the ta_ tables alone.
// The Drizzle Kit page documents no negation form for tablesFilter (orm.drizzle.team/docs/drizzle-config-file, read 2026-10-22).

import { index, integer, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";

export const taUser = sqliteTable(
  "ta_user",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    email: text("email").notNull(),
    emailVerified: integer("email_verified", { mode: "boolean" }).notNull(),
    name: text("name"),
    image: text("image"),
    bannedAt: integer("banned_at", { mode: "timestamp_ms" }),
    banReason: text("ban_reason"),
    banUntil: integer("ban_until", { mode: "timestamp_ms" }),
  },
  (t) => [
    uniqueIndex("ux_ta_user__email").on(t.email),
  ],
);

export const taIdentity = sqliteTable(
  "ta_identity",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    userId: text("user_id").notNull(),
    provider: text("provider").notNull(),
    subject: text("subject").notNull(),
    linkedAt: integer("linked_at", { mode: "timestamp_ms" }).notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_identity__provider__subject").on(t.provider, t.subject),
    index("ix_ta_identity__user_id").on(t.userId),
  ],
);

export const taSession = sqliteTable(
  "ta_session",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    userId: text("user_id").notNull(),
    tokenHash: text("token_hash").notNull(), // hash
    expiresAt: integer("expires_at", { mode: "timestamp_ms" }).notNull(),
    lastSeenAt: integer("last_seen_at", { mode: "timestamp_ms" }).notNull(),
    ip: text("ip"),
    userAgent: text("user_agent"),
    activeOrganizationId: text("active_organization_id"),
    freshAt: integer("fresh_at", { mode: "timestamp_ms" }),
    actorId: text("actor_id"),
    activeTeamId: text("active_team_id"),
  },
  (t) => [
    uniqueIndex("ux_ta_session__token_hash").on(t.tokenHash),
    index("ix_ta_session__user_id").on(t.userId),
    index("ix_ta_session__active_organization_id").on(t.activeOrganizationId),
  ],
);

export const taVerification = sqliteTable(
  "ta_verification",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
