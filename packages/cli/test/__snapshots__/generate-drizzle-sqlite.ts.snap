);

export const taScimToken = sqliteTable(
  "ta_scim_token",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    organizationId: text("organization_id").notNull(),
    name: text("name").notNull(),
    tokenHash: text("token_hash").notNull(), // hash
    hint: text("hint").notNull(),
    scopes: text("scopes", { mode: "json" }).notNull(),
    expiresAt: integer("expires_at", { mode: "timestamp_ms" }),
    lastUsedAt: integer("last_used_at", { mode: "timestamp_ms" }),
  },
  (t) => [
    uniqueIndex("ux_ta_scim_token__token_hash").on(t.tokenHash),
    index("ix_ta_scim_token__organization_id").on(t.organizationId),
  ],
);

export const taScimUser = sqliteTable(
  "ta_scim_user",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    organizationId: text("organization_id").notNull(),
    userId: text("user_id").notNull(),
    userName: text("user_name").notNull(),
    userNameKey: text("user_name_key").notNull(),
    externalId: text("external_id"),
    active: integer("active", { mode: "boolean" }).notNull(),
    displayName: text("display_name"),
    data: text("data", { mode: "json" }).notNull(),
    version: integer("version").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_scim_user__organization_id__user_id").on(t.organizationId, t.userId),
    uniqueIndex("ux_ta_scim_user__organization_id__user_name_key").on(t.organizationId, t.userNameKey),
    index("ix_ta_scim_user__organization_id__external_id").on(t.organizationId, t.externalId),
  ],
);

export const taScimGroup = sqliteTable(
  "ta_scim_group",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    organizationId: text("organization_id").notNull(),
    displayName: text("display_name").notNull(),
    displayNameKey: text("display_name_key").notNull(),
    externalId: text("external_id"),
    teamId: text("team_id"),
    version: integer("version").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_scim_group__organization_id__display_name_key").on(t.organizationId, t.displayNameKey),
    index("ix_ta_scim_group__organization_id__external_id").on(t.organizationId, t.externalId),
  ],
);

export const taScimGroupMember = sqliteTable(
  "ta_scim_group_member",
  {
    id: text("id").primaryKey(),
    createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
    updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
    groupId: text("group_id").notNull(),
    scimUserId: text("scim_user_id").notNull(),
  },
  (t) => [
    uniqueIndex("ux_ta_scim_group_member__group_id__scim_user_id").on(t.groupId, t.scimUserId),
    index("ix_ta_scim_group_member__scim_user_id").on(t.scimUserId),
  ],
);
