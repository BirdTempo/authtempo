{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // test/mcp.test.ts writes the entry of the real server binary, so the MCP
    // package must be built first. A task dependency, not a package one: the
    // MCP package depends on this package's ./program entry (plan 11e Task 5).
    "test": {
      "dependsOn": ["^build", "build", "authtempo-example-node#test", "@authtempo/mcp#build"]
    },
    // test/program.test.ts imports the package's own entry @authtempo/cli/program,
    // which resolves to dist/program.d.ts. So the typecheck needs this package's build (plan 11e).
    "typecheck": { "dependsOn": ["^build", "build"] }
  }
}
