{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": { "dependsOn": ["^build", "build", "authtempo-example-node#test"] },
    // test/program.test.ts imports the package's own entry @authtempo/cli/program,
