{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authtempo-adapter-d1-test",
  "compatibility_date": "2026-09-30",
  // No compatibility_flags: @cloudflare/vitest-plugin 1.4.0 turns Node.js
  // modules on for its runner whatever the flags say (dist/pool/index.mjs,
  // read 2026-10-11), so this config cannot show that the adapter runs
  // without nodejs_compat. The example Worker's proof/bundle-no-node.mjs
  // bundles this adapter with nodejs_compat off (plan 9b).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authtempo-test",
      // A placeholder: the Workers test pool runs D1 locally and never reads it.
      "database_id": "authtempo-test",
      // Relative to this config file.
      "migrations_dir": "migrations"
    },
    {
      // Plan 12b: a database that the migration test brings to version 8,
      // fills, and then moves to version 9. No migrations_dir: the test
      // applies the files itself.
      "binding": "STAGED",
      "database_name": "authtempo-test-staged",
      "database_id": "authtempo-test-staged"
    },
    {
      // An empty database for the DDL side of the shape check (plan 12g).
      "binding": "DDL_DB",
      "database_name": "authtempo-test-ddl",
      "database_id": "ddl-test"
    },
    {
      // Plan 12p: the same rows at version 15 in two databases. PAGED takes
      // the fill by hand in pages, and PAGED_COPY the shipped 0016 file. No
      // migrations_dir: the test applies the files itself.
      "binding": "PAGED",
      "database_name": "authtempo-test-paged",
      "database_id": "authtempo-test-paged"
    },
    {
      "binding": "PAGED_COPY",
      "database_name": "authtempo-test-paged-copy",
      "database_id": "authtempo-test-paged-copy"
    }
  ]
}
