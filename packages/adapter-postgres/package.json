{
  "name": "@authtempo/adapter-postgres",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && TEMPO_AUTH_PG_DRIVER=4 vitest run"
  },
  "dependencies": {
    "@authtempo/core": "workspace:*"
  },
  "peerDependencies": {
    "postgres": "^3.4.9 || ^4.1.1"
  },
  "devDependencies": {
    "postgres": "3.4.9",
    "postgres-4": "npm:postgres@4.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
