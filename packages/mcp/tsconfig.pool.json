{
  "extends": "../../tsconfig.base.json",
  // The remote Worker and its pool tests (plan 11e Task 16), with the Workers
  // types and no Node types. The Worker's imports bring in the files of the
  // remote surface; a Node type in one of them fails this check.
  "compilerOptions": {
    "noEmit": true,
    // The base config adds DOM. workers-types declares the same globals and conflicts with it.
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker.ts", "test/pool"]
}
