{
  "name": "@authtempo/sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node ../../scripts/check-no-node.mjs src"
  },
  "dependencies": {
    "@authtempo/client": "workspace:*",
    "@authtempo/core": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "happy-dom": "20.14.6",
    "svelte": "5.57.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
