{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tempo-auth-import-d1",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  // The import code runs without Node.js modules, as the app's Worker does.
  // Every Worker config sets both flags: Workers turn nodejs_compat on by
  // default from compatibility date 2026-08-04 (Cloudflare changelog, read
  // 2026-10-11), and these two turn it off. Remove them and a bundle of a
  // node: import builds without a warning.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  // Do not deploy this Worker: a deploy uploads the input, with the hashes,
  // to Cloudflare. So it has no workers.dev URL, no preview URL, and no
  // routes, and the Worker refuses to run without --var LOCAL_IMPORT:1.
  "workers_dev": false,
  "preview_urls": false,
  // core (default) writes core's tables; compat writes the app's Better Auth
  // 1.7 tables (worker/README.md). `--var TARGET:compat` sets it per run.
  // Any other value refuses at start and writes nothing.
  "vars": { "TARGET": "core" },
  // The git-ignored file the CLI's --d1-bundle writes (worker/README.md).
  // The build fails until it exists, so the Worker never runs on old input.
  "alias": { "tempo-auth-import-input": "./input/import.local.json" },
  "d1_databases": [
    {
      "binding": "DB",
      // Set both to the app's database (the values in the app's wrangler config).
      // `wrangler dev` runs on the local copy in .wrangler/state unless the
      // entry also sets "remote": true (worker/README.md, step 2).
      "database_name": "REPLACE_WITH_THE_APP_DATABASE_NAME",
      "database_id": "REPLACE_WITH_THE_APP_DATABASE_ID",
      "migrations_dir": "../../adapter-d1/migrations"
    }
  ]
}
