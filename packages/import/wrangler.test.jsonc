{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempo-auth-import-test",
  "compatibility_date": "2026-09-30",
  // Every Worker config sets both flags: Workers turn nodejs_compat on by
  // default from compatibility date 2026-08-04 (Cloudflare changelog, read
  // 2026-10-11), and these two turn it off. Without them a config states the
  // opposite of the rule. The pool ignores them: @cloudflare/vitest-plugin
  // 1.4.0 turns Node.js modules on for its runner whatever the flags say
  // (dist/pool/index.mjs, read 2026-10-11), so this config cannot show that
  // the import runs without nodejs_compat. The bundle check of
  // worker/wrangler.jsonc shows that (worker/README.md, plan 9b Task 14).
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "d1_databases": [
    // A placeholder: the Workers test pool runs D1 locally and never reads it.
    {
      "binding": "DB",
      "database_name": "tempo-auth-import-test",
      "database_id": "tempo-auth-import-test"
    }
  ]
}
