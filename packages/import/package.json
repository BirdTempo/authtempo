{
  "name": "@authtempo/import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "worker/README.md",
    "worker/wrangler.jsonc",
    "worker/src",
    "worker/proof"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.d1.json",
    "test": "vitest run && vitest run -c vitest.d1.config.ts && node worker/proof/bundle-no-node.mjs && node worker/proof/pack-files.mjs"
  },
  "dependencies": {
    "@authtempo/adapter-d1": "workspace:*",
    "@authtempo/compat-better-auth": "workspace:*",
    "@authtempo/core": "workspace:*",
    "@authtempo/legacy-hashes": "workspace:*"
  },
  "devDependencies": {
    "@authtempo/adapter-postgres": "workspace:*",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/node": "24.19.1",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
