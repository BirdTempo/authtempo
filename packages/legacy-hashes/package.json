{
  "name": "@authtempo/legacy-hashes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cognito": {
      "types": "./dist/cognito.d.ts",
      "default": "./dist/cognito.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node proof/no-node.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "bcryptjs": "3.0.3"
  },
  "peerDependencies": {
    "@authtempo/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@authtempo/core": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
