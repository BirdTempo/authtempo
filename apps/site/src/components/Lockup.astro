---
// biome-ignore-all lint/correctness/noUnusedImports: the template uses each import, and Biome 2.5.15 reads the frontmatter only
// The lockup of brand spec 3: the mark and the wordmark in one SVG, named
// "authtempo" by its aria-label. With beat, the bars of the mark move
// (tokens.css, .at-beat .at-mark rect), except with reduced motion.
// The template reads Astro.props in place: Biome 2.5.15 lints this
// frontmatter and not the template, so a destructured prop reads as unused.
import Wordmark from "../assets/wordmark.svg";

interface Props {
  href: string;
  beat?: boolean;
  /** "no" keeps a page translator off the name (Starlight's title carries it). */
  translate?: "no";
}
---
<a class:list={["at-lockup", { "at-beat": Astro.props.beat === true }]} href={Astro.props.href} translate={Astro.props.translate}><Wordmark class="at-wordmark" /></a>
<style>
  .at-lockup { display: inline-flex; align-items: center; color: var(--at-ink); text-decoration: none; }
  .at-lockup :global(.at-wordmark) { display: block; height: 1.75rem; width: auto; }
</style>
