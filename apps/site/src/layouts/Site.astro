---
// biome-ignore-all lint/correctness/noUnusedImports: the template uses each import, and Biome 2.5.15 reads the frontmatter only
// biome-ignore-all lint/correctness/noUnusedVariables: the template uses each const, and Biome 2.5.15 reads the frontmatter only
// The one layout of the root pages (brand spec 9 and 13). Plan 11b builds
// its pages on it. The one inline script of the root pages is the theme toggle.
// The template reads Astro.props in place: Biome 2.5.15 lints this
// frontmatter and not the template, so a destructured prop reads as unused.
import corePackage from "../../../../packages/core/package.json";
import { parseTokens } from "../../scripts/lib/tokens.ts";
import Icon from "../components/Icon.astro";
import Lockup from "../components/Lockup.astro";
import { HOME } from "../data/home.ts";
import { rootLicense } from "../data/repo.ts";
import { FOOTER_LINKS, NAV_LINKS, REPO_URL, SITE } from "../data/site.ts";
import toggle from "../scripts/theme-toggle.js?raw";
import "../styles/tokens.css";
import tokensCss from "../styles/tokens.css?raw";

interface Props {
  title: string;
  description: string;
  path: string;
}
const tokens = parseTokens(tokensCss);
const canonical = new URL(Astro.props.path, SITE.origin).href;
// A nav link to the page itself carries aria-current="page" (plan 11b). Astro
// writes no attribute for undefined, so every other link has none.
const current = (href: string): "page" | undefined =>
  href === Astro.props.path ? "page" : undefined;
// One source per fact (design spec 24 item 3): the license of the root
// package.json, or the stated empty state until plan 12j sets it. /pricing/
// reads the same function.
const license: string = rootLicense() ?? HOME.noLicense;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title === HOME.title ? Astro.props.title : `${Astro.props.title} · ${HOME.title}`}</title>
    <meta name="description" content={Astro.props.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={tokens.light.get("--at-paper")} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={tokens.darkAttr.get("--at-paper")} />
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description} />
    <meta property="og:image" content={`${SITE.origin}/og.png`} />
    {/* The one inline script of the root pages (brand spec 12, decision of 2026-10-15). It sets data-theme before the first paint and cycles the toggle. check-script allows its SHA-256 only. */}
    <script is:inline set:html={toggle}></script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{HOME.skip}</a>
    <header class="site-header">
      <Lockup href="/" beat />
      <nav aria-label={SITE.nav}>
        {NAV_LINKS.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
        {REPO_URL !== null && <a class="mono" href={REPO_URL}>{SITE.repo}</a>}
      </nav>
      <button type="button" class="at-toggle" data-theme-toggle aria-label="Use the light theme">
        <Icon name="half-disc" class="at-toggle-auto" />
        <Icon name="sun" class="at-toggle-light" />
        <Icon name="moon" class="at-toggle-dark" />
      </button>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>{HOME.title} · {license}</span>
      <nav aria-label={SITE.footerNav}>
        {FOOTER_LINKS.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
      </nav>
      <span class="mono">{corePackage.version}</span>
    </footer>
  </body>
</html>
<style is:global>
  html { background: var(--at-paper); }
  body { margin: 0; color: var(--at-ink); background: var(--at-paper); font-family: var(--at-font-sans); font-size: var(--at-text-body); line-height: var(--at-leading-body); }
  code, pre, .mono { font-family: var(--at-font-mono); }
  a { color: var(--at-accent-text); }
  img, svg, pre, table { max-width: 100%; }
</style>
<style>
  .skip { position: absolute; left: -100vw; }
  /* On focus the link sits over the header on paper, inside the global ring of spec 14. */
  .skip:focus-visible { left: var(--at-margin); top: var(--at-unit); z-index: 1; padding: var(--at-unit) calc(var(--at-unit) * 2); background: var(--at-paper); }
  .site-header, main, .site-footer { box-sizing: border-box; max-width: var(--at-frame); margin-inline: auto; padding-inline: var(--at-margin); }
  .site-header { display: flex; flex-wrap: wrap; align-items: center; gap: var(--at-rhythm); min-height: 4rem; border-bottom: 1px solid var(--at-line); }
  .site-header nav { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--at-unit) * 3); margin-inline-start: auto; }
  .site-header nav a { color: var(--at-ink); text-decoration: none; font-weight: 500; }
  .site-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--at-rhythm); padding-block: var(--at-rhythm); border-top: 1px solid var(--at-line); color: var(--at-mute); font-size: var(--at-text-small); }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: calc(var(--at-unit) * 3); }
  .site-footer nav a { color: var(--at-mute); }
  .at-toggle { display: inline-grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border: 1px solid var(--at-line); border-radius: 0.5rem; background: transparent; color: var(--at-ink); cursor: pointer; }
  .at-toggle :global(.at-icon) { display: none; grid-area: 1 / 1; width: 1.25rem; height: 1.25rem; }
  :global(:root[data-theme-choice="auto"]) .at-toggle :global(.at-toggle-auto),
  :global(:root[data-theme-choice="light"]) .at-toggle :global(.at-toggle-light),
  :global(:root[data-theme-choice="dark"]) .at-toggle :global(.at-toggle-dark) { display: block; }
  /* With no script, the page follows the system scheme, and the toggle hides (brand spec 12). */
  :global(:root:not([data-theme-choice])) .at-toggle { display: none; }
</style>
