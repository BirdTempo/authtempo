{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // The checks run as .ts files under Node's type stripping, which needs the
    // .ts extension in each relative import.
    "allowImportingTsExtensions": true,
    // tsc reads the JSDoc type of frameworks.mjs, the one list that
    // astro.config.mjs and test/sidebar-frameworks.test.ts import.
    "allowJs": true,
    // TypeScript 7 loads no @types package unless "types" names it. The checks read node:fs.
    "types": ["node"]
  },
  // src/ holds Astro files and the content config, which import Astro's virtual
  // modules; astro build checks them. tsc checks the samples, the checks, and the tests.
  // src/data holds plain TypeScript that the checks and the pages share. It imports
  // no Astro module, so tsc checks it (plan 11b1).
  "include": ["samples", "scripts", "test", "src/data"]
}
