{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authtempo-site",
  // Wrangler sets workers_dev to true when no route is given, so the first
  // deploy would publish a workers.dev URL. Publication is the owner's call:
  // the owner turns these two on at publication (wrangler docs, read 2026-10-14).
  "workers_dev": false,
  "preview_urls": false,
  // The same date as examples/worker. The Worker has no script, so the
  // Node.js compatibility flags change nothing here.
  "compatibility_date": "2026-09-30",
  // Ruling 14 of the plan 11b lane. wrangler runs this command before each
  // deploy, dry run, and dev start. It fails when dist/_headers lacks the CSP
  // of this build, or when dist/_headers.template is still there. Without it,
  // `astro build` then `wrangler deploy` ships a site with no CSP. It does not
  // build: a build here would rewrite dist while check.ts reads it (its
  // check-deploy row runs the dry run), and would build twice in preview.
  // The command runs in the shell's folder, not in the folder of this file.
  // So run each deploy from apps/site, or through
  // `pnpm --filter @authtempo/site exec wrangler deploy`. From the repo root
  // the guard is not found, and the deploy fails.
  "build": { "command": "node scripts/guard-deploy.ts" },
  "assets": {
    "directory": "./dist",
    // A path with no file answers the nearest 404.html with status 404.
    // "single-page-application" answers 200 for every miss and hides a broken
    // link from the link check and from a crawler (Cloudflare static assets
    // page, read 2026-10-14).
    "not_found_handling": "404-page"
  }
  // No "main": with no Worker script a request for a missing file answers 404,
  // and requests to static assets are free (Cloudflare docs, read 2026-10-14).
  // Limits, read 2026-10-14: 20,000 files per Worker version on Workers Free,
  // 100,000 on Workers Paid, 25 MiB per file. check-size.ts keeps a margin.
  // Plan 11a never deploys this Worker. The owner publishes.
}
