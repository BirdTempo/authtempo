{
  "name": "@authtempo/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "ASTRO_TELEMETRY_DISABLED=1 astro build && { node scripts/check.ts; c=$?; vitest run; v=$?; [ $c -eq 0 ] && [ $v -eq 0 ]; }",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro build && WRANGLER_SEND_METRICS=false wrangler dev",
    "preview:smoke": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/preview-smoke.ts"
  },
  "dependencies": {
    "@authtempo/adapter-d1": "workspace:*",
    "@authtempo/adapter-postgres": "workspace:*",
    "@authtempo/breach-check": "workspace:*",
    "@authtempo/captcha-turnstile": "workspace:*",
    "@authtempo/client": "workspace:*",
    "@authtempo/compat-better-auth": "workspace:*",
    "@authtempo/core": "workspace:*",
    "@authtempo/handoff": "workspace:*",
    "@authtempo/import": "workspace:*",
    "@authtempo/legacy-hashes": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "@authtempo/cli": "workspace:*",
    "@types/node": "24.19.1",
    "astro": "7.3.8",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
