{
  "name": "authtempo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "node scripts/test-servers.mjs run -- turbo run test",
    "typecheck": "turbo run typecheck typecheck:configs",
    "typecheck:configs": "tsc -p tsconfig.configs.json && node scripts/check-config-count.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release:check": "node scripts/release/src/release-check.ts",
    "release:dry-run": "node scripts/release/src/dry-run.ts",
    "release:rehearse": "node scripts/release/src/rehearse.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
