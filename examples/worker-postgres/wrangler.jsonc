{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  // postgres.js opens a TCP socket through Node.js APIs, so this Worker needs
  // nodejs_compat. It is on by default from the 2026-08-04 compatibility date.
  // It stays explicit so that a copy of the D1 config's no_nodejs_compat does
  // not break the driver. Core itself uses none (spec 4).
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The origin of this Worker. Change it to your own origin before a deploy.
    "BASE_URL": "https://example.test"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this with the id that `wrangler hyperdrive create` prints.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` connects here instead: the Postgres of the repo's docker compose.
      "localConnectionString": "postgres://tempo:tempo@localhost:5439/tempo_auth"
    }
  ],
  // Workers Logs keeps the events of the Workers Logs sink of
  // @authtempo/observe (plan 12h). A default is not a promise, so this block
  // states it. Read 2026-10-14 at developers.cloudflare.com/workers/
  // observability/logs/workers-logs/: Free 200,000 log events a day and 3 days
  // of retention; Paid 20 million a month, then $0.60 a million, and 7 days;
  // from 2026-12-01 Workers Logs moves to Cloudflare Observability pricing.
  "observability": {
    "enabled": true,
    // 1 keeps every request. A rate below 1 drops whole requests, and with
    // them the sign-in events of those requests (OWASP ASVS 5.0.0 16.3.1).
    // Lower it only with the OTLP sink as the record of security events.
    "head_sampling_rate": 1
  },
  // The sweep deletes expired links, codes, and sessions. Without a trigger
  // they stay in Postgres forever.
  "triggers": { "crons": ["17 * * * *"] }
  // AUTH_SECRET is a secret: `wrangler secret put AUTH_SECRET`.
}
