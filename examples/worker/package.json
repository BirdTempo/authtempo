{
  "name": "authtempo-example-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "proof:dev-check": "node proof/dev-check.mjs",
    "proof:webauthn": "node proof/webauthn.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node proof/bundle-no-node.mjs"
  },
  "dependencies": {
    "@authtempo/adapter-d1": "workspace:*",
    "@authtempo/adapter-postgres": "workspace:*",
    "@authtempo/client": "workspace:*",
    "@authtempo/compat-better-auth": "workspace:*",
    "@authtempo/core": "workspace:*",
    "@authtempo/handoff": "workspace:*",
    "@authtempo/import": "workspace:*",
    "@authtempo/legacy-hashes": "workspace:*",
    "@authtempo/verify": "workspace:*"
  },
  "devDependencies": {
    "@authtempo/cli": "workspace:*",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
