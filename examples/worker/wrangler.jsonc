{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempo-auth-example",
  "main": "src/index.ts",
  // Checked against the consumera research of 2026-09-30: workerd supports
  // 2026-09-30. No compatibility_flags on purpose: the core must run
  // without nodejs_compat, and this Worker proves it.
  "compatibility_date": "2026-09-30",
  "vars": {
    "BASE_URL": "https://example.test",
    "TEST_MODE": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tempo-auth-example",
      // A placeholder for local tests. A real deploy needs the id that
      // `wrangler d1 create` prints; with this value the deploy fails.
      "database_id": "tempo-auth-example",
      // The adapter package ships the migrations. wrangler reads this path
      // relative to this config file, not to the shell's directory. In a
      // real app the path is node_modules/@tempo-auth/adapter-d1/migrations;
      // here the workspace link resolves to the same files.
      "migrations_dir": "../../packages/adapter-d1/migrations"
    }
  ]
  // AUTH_SECRET is a secret: `wrangler secret put AUTH_SECRET` in a real
  // deployment. The test config sets it in vitest.config.ts.
}
