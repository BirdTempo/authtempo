{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authtempo-example",
  "main": "src/index.ts",
  // Checked against the consumera research of 2026-09-30: workerd supports
  // 2026-09-30. From compatibility date 2026-08-04 Workers turn nodejs_compat
  // on by default (Cloudflare changelog, read 2026-10-11), so a date alone
  // proves nothing. The two flags turn it off, and the packages must run
  // without it. The proof is `node proof/bundle-no-node.mjs` (in `test`),
  // not the vitest pool, which turns Node.js modules on for its runner.
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "vars": {
    "BASE_URL": "https://example.test",
    "TEST_MODE": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authtempo-example",
      // A placeholder for local tests. A real deploy needs the id that
      // `wrangler d1 create` prints; with this value the deploy fails.
      "database_id": "authtempo-example",
      // The adapter package ships the migrations. wrangler reads this path
      // relative to this config file, not to the shell's directory. In a
      // real app the path is node_modules/@authtempo/adapter-d1/migrations;
      // here the workspace link resolves to the same files.
      "migrations_dir": "../../packages/adapter-d1/migrations"
    },
    {
      // The compat example: Better Auth 1.7's tables with authtempo in place (plan 9).
      // A real app runs Better Auth's own table migration first, then this directory.
      "binding": "BA_DB",
      "database_name": "authtempo-example-better-auth",
      // A placeholder for local tests, as for DB.
      "database_id": "authtempo-example-better-auth",
      "migrations_dir": "../../packages/compat-better-auth/migrations/d1"
    }
  ],
  // Workers Logs keeps the events of the Workers Logs sink of
  // @authtempo/observe (plan 12h). A default is not a promise, so this block
  // states it. Read 2026-10-14 at developers.cloudflare.com/workers/
  // observability/logs/workers-logs/: Free 200,000 log events a day and 3 days
  // of retention; Paid 20 million a month, then $0.60 a million, and 7 days;
  // from 2026-12-01 Workers Logs moves to Cloudflare Observability pricing.
  "observability": {
    "enabled": true,
    // 1 keeps every request. A rate below 1 drops whole requests, and with
    // them the sign-in events of those requests (OWASP ASVS 5.0.0 16.3.1).
    // Lower it only with the OTLP sink as the record of security events.
    "head_sampling_rate": 1
  },
  // Expired magic link tokens, consumed tokens, and stale invitations pile up
  // in D1 until something deletes them. Without this trigger they stay forever.
  "triggers": { "crons": ["*/15 * * * *"] }
  // AUTH_SECRET is a secret: `wrangler secret put AUTH_SECRET` in a real
  // deployment. The test config sets it in vitest.config.ts.
}
