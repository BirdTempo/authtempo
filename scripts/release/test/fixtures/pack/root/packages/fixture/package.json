{
  "name": "@authtempo/fixture",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authtempo/authtempo.git",
    "directory": "packages/fixture"
