{
  "$schema": "https://turbo.build/schema.json",
  // The addresses of the test servers of the worktree's slot. Turbo runs in
  // strict env mode, so a variable not listed here never reaches a test, and
  // the helper then stops with "not set". scripts/test-servers.mjs run sets
  // them. apps/site/test/test-ports.test.ts holds this list to the variables
  // that the helpers read and to scripts/test-ports.mjs.
  "globalPassThroughEnv": [
    "AUTHTEMPO_LIBSQL_CLI_URL",
    "AUTHTEMPO_LIBSQL_COMPAT_URL",
    "AUTHTEMPO_LIBSQL_URL",
    "AUTHTEMPO_MYSQL84_URL",
    "AUTHTEMPO_MYSQL97_URL",
    "TEMPO_AUTH_PG_URL"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    // The site build reads the root package.json, SECURITY.md, and LICENSE
    // (apps/site/src/data/repo.ts). Without these inputs, a cache hit serves a
    // stale license or a stale empty state (ruling 21 of the plan 11b lane).
    // The docs pages also import each example file below with ?raw, and no
    // example is a dependency of the site (ruling 22). The [...path] folder of
    // next is a * here, because a glob reads [ ] as a set of characters.
    // build-feed.ts reads each packages/*/CHANGELOG.md and the name in each
    // packages/*/package.json, so a new release misses the cache (plan 11b Task 7).
    // apps/site/test/turbo-inputs.test.ts holds the list to the imports and the feed.
    "@authtempo/site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/examples/elysia/src/app.ts",
        "$TURBO_ROOT$/examples/elysia/test/app.test.ts",
        "$TURBO_ROOT$/examples/mcp-server/src/auth.ts",
        "$TURBO_ROOT$/examples/mcp-server/src/fetch.ts",
        "$TURBO_ROOT$/examples/mcp-server/src/index.ts",
        "$TURBO_ROOT$/examples/mcp-server/src/mcp.ts",
        "$TURBO_ROOT$/examples/nestjs/src/app.ts",
        "$TURBO_ROOT$/examples/nestjs/test/app.test.ts",
        "$TURBO_ROOT$/examples/next/app/auth/*/route.ts",
        "$TURBO_ROOT$/examples/next/app/layout.tsx",
        "$TURBO_ROOT$/examples/next/app/page.tsx",
        "$TURBO_ROOT$/examples/next/app/providers.tsx",
        "$TURBO_ROOT$/examples/next/lib/auth.ts",
        "$TURBO_ROOT$/examples/next/proxy.ts",
        "$TURBO_ROOT$/examples/node/src/app.ts",
        "$TURBO_ROOT$/examples/node/src/main.ts",
        "$TURBO_ROOT$/examples/node/src/server-bun.ts",
        "$TURBO_ROOT$/examples/node/src/server-node.ts",
        "$TURBO_ROOT$/examples/node/test/e2e.ts",
        "$TURBO_ROOT$/examples/react/src/App.tsx",
        "$TURBO_ROOT$/examples/react/src/main.tsx",
        "$TURBO_ROOT$/examples/worker-d1/src/index.ts",
        "$TURBO_ROOT$/examples/worker-d1/test/observe-flush.test.ts",
        "$TURBO_ROOT$/examples/worker-d1/test/sign-in.test.ts",
        "$TURBO_ROOT$/examples/worker-d1/wrangler.jsonc",
        "$TURBO_ROOT$/examples/worker-postgres/scripts/migrate.ts",
        "$TURBO_ROOT$/examples/worker-postgres/src/index.ts",
        "$TURBO_ROOT$/examples/worker-postgres/test/sign-in.test.ts",
        "$TURBO_ROOT$/examples/worker-postgres/wrangler.jsonc"
      ]
    },
    // The demo build copies the token file and the fonts of the site into its
    // assets (plan 11b Task 10). No package of the site is a dependency of the
    // demo, so without these inputs a cache hit serves old tokens or fonts.
    "@authtempo/demo#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/site/src/styles/tokens.css",
        "$TURBO_ROOT$/apps/site/public/fonts/*"
      ]
    },
    // Ruling 44 of the plan 11b lane: only demo#build writes apps/demo/dist and
    // src/migrations.gen.ts. One run starts the demo build (the site depends on
    // the demo), test, and typecheck at once. So test and typecheck wait for
    // the build and only read its output; two writers of one dist raced.
    // apps/demo/test/node/scripts.test.ts holds the scripts and these lines.
    "@authtempo/demo#test": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    // The demo typecheck also reads the site checks that test/node/prose.test.ts imports.
    "@authtempo/demo#typecheck": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/site/src/styles/tokens.css",
        "$TURBO_ROOT$/apps/site/public/fonts/*",
        "$TURBO_ROOT$/apps/site/scripts/**"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] },
    // A build empties its dist first (scripts/clean-dist.mjs). A test that reads
    // its own dist, or runs tsc into it as pack-files does, must not run while
    // that build deletes it. So each test waits for its own build too.
    // apps/site/test/clean-dist.test.ts holds this line.
    "test": { "dependsOn": ["^build", "build"], "cache": false },
    "//#typecheck:configs": { "cache": false }
  }
}
